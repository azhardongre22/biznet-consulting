PORT=3001

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-app-password

MAIL_FROM="Website Enquiry <you@example.com>"
MAIL_TO=enquiries@example.com

# Public origin for welcome / unsubscribe / confirm links emailed to
# subscribers. In dev, use the Vite dev URL (the Vite proxy forwards
# /api/* here). In production, set this to the live site origin
# (e.g. https://biznetconsulting.ae).
PUBLIC_SITE_URL=http://localhost:5174

# Set to "true" to require subscribers to click a confirmation link
# before receiving the welcome email (double opt-in). Default off.
REQUIRE_DOUBLE_OPT_IN=false

# Bearer token for the admin endpoints:
#   GET /api/subscribers              -> JSON list + status stats
#   GET /api/subscribers?status=...   -> filter by pending|confirmed|unsubscribed
#   GET /api/subscribers.csv          -> CSV export (defaults to confirmed only)
#   GET /api/subscribers.csv?status=all -> include every record
# Send as: Authorization: Bearer <value>
NEWSLETTER_API_KEY=change-me-to-a-long-random-string

# --- CMS public API (browser uses same-origin /api/cms; do not set to :3010) ---
# Optional override for the Vite/SPA client. Default: /api/cms
# VITE_CMS_API_BASE=/api/cms

# --- Site API press fallback (server.js on :3001) — optional / unused by SPA ---
# The newsroom frontend reads from /api/cms (biznet-cms-api). These DB vars
# only apply if you still run the legacy read endpoints in server.js.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=biznet_admin_user
DB_PASSWORD=
DB_NAME=biznet_admin
# Local dev only: absolute path to the CMS uploads/cms folder. In production
# Nginx serves /uploads/ directly, so this is not used there.
PRESS_UPLOADS_DIR=
UPLOADS_PUBLIC_BASE=/uploads/cms

# --- SEO (lib/seo-refresh.js, scripts/prerender.mjs) — see deploy/README.md ---
CMS_API_BASE=https://biznetconsulting.ae/api/cms
# Long random string; enables POST /api/seo/refresh (unset → 503)
SEO_REFRESH_TOKEN=
# SEO_WATCHDOG=off
# SEO_WATCHDOG_INTERVAL_MS=300000
# SEO_FULL_REFRESH_MS=86400000
