# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.*

# Newsletter subscriber storage (repo-root only — do not ignore src/data/)
/data/
subscribers.json

# Large source brochure PDFs — app imports only from optimized/
# Keep masters locally; never push the 60MB+ originals to GitHub.
src/assets/company-profile/*.pdf

# Raster image masters — keep locally; only push optimized WebP (+ SVGs/JSON).
# Run `npm run optimize:images` after changing a source, then commit optimized/.
src/assets/images/**/*.png
src/assets/images/**/*.jpg
src/assets/images/**/*.jpeg
src/assets/images/**/*.webp
!src/assets/images/optimized/
!src/assets/images/optimized/**

src/assets/icons/**/*.png
src/assets/icons/**/*.jpg
src/assets/icons/**/*.jpeg
src/assets/icons/**/*.webp
!src/assets/icons/optimized/
!src/assets/icons/optimized/**

